# aws-cloud-labs configuration
#
# Every script reads one KEY="value" file, ~/cits5503/lab.env by default.
# Point a run at a different file with:  LAB_ENV=/path/to/file ./script.sh
#
#   mkdir -p ~/cits5503
#   cp config.example.env ~/cits5503/lab.env
#   chmod 600 ~/cits5503/lab.env
#
# lab-01-cli-setup/lab1_setup.sh also writes the three required values for you.
# The scripts append their own keys (resource ids, IPs, ARNs) to the same file
# as they run, so treat it as private: it is never committed (see .gitignore).
#
# No AWS credentials go in here. They live in ~/.aws/credentials, written by
# `aws configure`, on the Linux filesystem (not under /mnt/c).

# ------------------------------------------------------------------ required
# Prefix for every resource name: <prefix>-sg, <prefix>-vm1, <prefix>-lab8, ...
# 2-9 characters, lowercase letters, digits and hyphens. S3 bucket names are
# global, so pick something unlikely to be taken. 9 characters is the ceiling
# because the SageMaker tuning job name (<prefix>-xgboost-tuningjob-01) is
# limited to 32.
LAB_PREFIX=""

# Region for every lab. ap-southeast-2 (Sydney) is where these were built and
# tested; Comprehend and Rekognition (Lab 9) are not fully available everywhere.
AWS_REGION="ap-southeast-2"

# Ubuntu AMI used by the EC2 labs (2, 5, 6, 7). AMI ids are per region: find a
# current Ubuntu LTS image in the EC2 console (Launch instance > AMI catalog)
# for the region above.
AWS_AMI=""

# ------------------------------------------- optional, shown with defaults
# Uncomment to override. Anything left out takes the default shown.

# Lab 1-2: working directory for the shared venv and per-lab scratch files
# (set as an environment variable, not in this file)
#   LAB_DIR="$HOME/cits5503"

# Lab 2: instance type and names
# INSTANCE_TYPE="t3.micro"
# SG_NAME="<prefix>-sg"            KEY_NAME="<prefix>-key"        VM1_NAME="<prefix>-vm1"
# SG_NAME_BOTO="<prefix>-sg-boto"  KEY_NAME_BOTO="<prefix>-key-boto"  VM2_NAME="<prefix>-vm2"
# KEY_FILE="$HOME/.ssh/<prefix>-key.pem"
# DOCKER_IMAGE="my-apache2"
# DOCKER_CONTAINER="my-app"
# DOCKER_PORT="80"                  # use 8080 if Windows has reserved port 80

# Lab 3: DynamoDB Local (these four are read from the environment)
# DDB_PORT="8000"
# DDB_ENDPOINT="http://localhost:8000"
# DDB_TABLE="CloudFiles"
# DDB_CONTAINER="dynamodb-local"   DDB_IMAGE="amazon/dynamodb-local"

# Lab 3-4: bucket and KMS alias (lab3_prepare.sh / lab4_prepare.sh write these)
# BUCKET_NAME="<prefix>-cloudstorage"
# KMS_ALIAS="alias/<prefix>"
# ROOT_DIR="rootdir"

# Lab 5-7: SSH
# KEY_NAME="<prefix>-key"
# KEY_PATH="$HOME/.ssh/<prefix>-key.pem"   # keep it on the Linux filesystem
# SSH_USER="ubuntu"

# Lab 6-7: Django
# DJANGO_PORT="8000"
# AWS_DDB_TABLE="UserFiles"
# LAB6_TREE="/path/to/rootdir"      # environment only: source tree for --from-tree
# LAB7_SSH_CONFIG="$HOME/.ssh/config"

# Lab 8: ECS / SageMaker (lab8_prepare.sh fills in any that are missing)
# LAB8_JUPYTER_PORT="8888"
# LAB8_JUPYTER_TOKEN=""             # generated randomly on first run if empty
# LAB8_TASK_ROLE="SageMakerRole"    # IAM role the ECS task and SageMaker job use
# LAB8_EXEC_ROLE="ecsTaskExecutionRole"
# LAB8_TASK_CPU="256"
# LAB8_TASK_MEMORY="512"
# LAB8_BASE_IMAGE="python:3.10"     # --slim switches to python:3.10-slim
# LAB8_SAGEMAKER_SPEC="sagemaker>=2.200,<3"
# LAB8_NOTEBOOK="LabAI.ipynb"
# LAB8_NOTEBOOK_URL="<raw URL of the course notebook>"
# LAB8_TUNING_JOB="<prefix>-xgboost-tuningjob-01"   # must be unique per account

# Lab 9: Rekognition
# LAB9_MIN_CONFIDENCE="80"
# LAB9_MAX_LABELS="20"
# LAB9_IMAGE_DIR="<repo>/lab-09-comprehend-rekognition/images"

# -------------------------------------------- written by the scripts
# Do not set these by hand; the scripts record them as they create things and
# read them back in later steps (and in the verify scripts):
#   SG_ID VM1_ID VM1_IP SG_ID_BOTO VM2_ID VM2_IP           (Lab 2)
#   IAM_USERNAME ACCOUNT_ID KMS_KEY_ID KMS_KEY_ARN          (Lab 4)
#   LAB5_*  LAB6_*  LAB7_*                                  (ids, IPs, ARNs, DNS names)
#   AWS_ACCOUNT_ID LAB8_ECR_URI LAB8_ECR_REGISTRY LAB8_IMAGE_URI LAB8_IMAGE_ARCH
#   LAB8_VPC_ID LAB8_SUBNET_IDS LAB8_SG_ID LAB8_TASK_DEF_ARN LAB8_PUBLIC_IP
#   LAB8_JUPYTER_URL LAB8_LOGS_ENABLED LAB9_BUCKET LAB9_IMAGE_*
